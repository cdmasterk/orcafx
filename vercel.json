{
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/api/recalculate-prices",
      "dest": "/api/recalculate-prices.js"
    },
    {
      "src": "/api/ly-reindex",
      "dest": "/api/ly-reindex.js"
    },
    {
      "src": "/(.*)",
      "dest": "/build/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/recalculate-prices",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/ly-reindex",
      "schedule": "*/10 * * * *"
    }
  ]
}
